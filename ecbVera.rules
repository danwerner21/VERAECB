
(rules PCB ecbVera
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 1)
    (layer_rule "F.Cu"
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.6)
    )
    (layer_rule "B.Cu"
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.6)
    )
  )
  (rule
    (width 200.0)
    (clear 200.0)
    (clear 100.0 (type smd_to_turn_gap))
    (clear 50.0 (type "smd"-"smd"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle "F.Cu" 600.0 0.0 0.0)
    )
    (shape
      (circle "B.Cu" 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" "default"
  )
  (via 
    "Via[0-1]_600:300_um-kicad_default" "Via[0-1]_600:300_um" "kicad_default"
  )
  (via_rule
    "default" "Via[0-1]_600:300_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_600:300_um-kicad_default"
  )
  (class "default"
    (clearance_class "default")
    (via_rule "default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "Net-(C28-Pad1)" "PD0" "B_A7" "B_D1" "B_D4" "PD1" "PD2" "B_A6"
    "B_D0" "B_A5" "B_A4" "B_D2" "B_D5" "B_D3" "B_D6" "B_D7"
    "PD3" "PD4" "PD5" "B_A3" "B_A2" "B_A1" "B_A0" "PD6"
    "PD7" "Net-(JP1-Pin_2)" "~{RES}" "B_~{IR0}" "Net-(K1-Pin_2)" "B_~{INT}" "unconnected-(P5-Pin_26-Pad26)" "~{BUSY}"
    "ACK" "PAPEROUT" "ERROR" "~{SEL}" "~{LINEFEED}" "SELECT" "~{STROBE}" "P-RESET"
    "unconnected-(P6-Pad1)" "Net-(U3-X2)" "unconnected-(P6-Pad3)" "unconnected-(P6-Pad2)" "unconnected-(P6-Pad12)" "unconnected-(P6-Pad13)" "unconnected-(P7-Pin_1-Pad1)" "MSEDAT"
    "unconnected-(P7-Pin_2-Pad2)" "unconnected-(P7-Pin_7-Pad7)" "MSECLK" "unconnected-(P7-Pin_9-Pad9)" "unconnected-(P7-Pin_10-Pad10)" "unconnected-(P7-Pin_5-Pad5)" "unconnected-(P8-Pin_2-Pad2)" "KBDCLK"
    "unconnected-(P8-Pin_5-Pad5)" "unconnected-(P8-Pin_10-Pad10)" "unconnected-(P8-Pin_9-Pad9)" "KBDDAT" "unconnected-(P8-Pin_7-Pad7)" "unconnected-(P8-Pin_1-Pad1)" "P15" "P12"
    "P21" "P13" "P20" "P17" "P14" "P16" "Net-(U10-O0)" "Net-(U10-O2)"
    "Net-(U10-O4)" "Net-(U10-O6)" "Net-(U10-O1)" "Net-(U10-O3)" "Net-(U10-O5)" "Net-(U10-O7)" "Net-(R9-Pad2)" "Net-(RR1-R7)"
    "PU4" "PU3" "Net-(RR1-R8)" "PU5" "PU2" "Net-(RR1-R9)" "PU7" "PU6"
    "B_~{IR7}" "unconnected-(RR2-R5-Pad6)" "B_~{IR2}" "PU1" "~{INT}" "PU8" "PROG" "Net-(U3-P23)"
    "Net-(U3-P26{slash}DRQ)" "Net-(U3-P27{slash}DAK)" "Net-(U3-P22)" "Net-(U1-Pad4)" "unconnected-(U2-Pad11)" "Net-(U5-CE)" "unconnected-(U2-Pad4)" "~{KEYB_PRINTER}"
    "~{VERA}" "unconnected-(U2-Pad9)" "unconnected-(U2-Pad13)" "unconnected-(U2-Pad12)" "unconnected-(U2-Pad6)" "unconnected-(U2-Pad8)" "unconnected-(U2-Pad10)" "unconnected-(U2-Pad5)"
    "D4" "~{WR}" "D6" "Net-(U3-CS)" "D5" "A0" "D1" "unconnected-(U3-SYNC-Pad11)"
    "D0" "D7" "Net-(U3-P24{slash}OB)" "Net-(U3-P25{slash}BF)" "unconnected-(U3-SSPP-Pad26)" "D3" "~{RD}" "D2"
