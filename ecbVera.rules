    "unconnected-(U6-31B-PadB31)" "unconnected-(U6-15A-PadA15)" "unconnected-(U6-19A-PadA19)" "B_{slash}BAO" "B_A13" "B_A22" "unconnected-(U6-13A-PadA13)" "B_A16"
    "B_A17" "B_A18" "B_{slash}IR6" "B_{slash}BUSRQ" "B_{slash}WAIT" "B_{slash}DS0" "B_{slash}SXTAK" "unconnected-(U6-30B-PadB30)"
    "B_~{IORQ}" "unconnected-(U6-2B-PadB2)" "B_{slash}RESET" "B_{slash}RD" "B_{slash}IEO" "B_D12" "unconnected-(U6-26A-PadA26)" "unconnected-(U6-23A-PadA23)"
    "B_A8" "B_{slash}IR4" "B_VBAT" "B_D15" "unconnected-(U6-15C-PadC15)" "B_{slash}RFSH" "unconnected-(U6-25A-PadA25)" "unconnected-(U6-26C-PadC26)"
    "B_{slash}TEND" "B_A10" "B_A14" "unconnected-(U6-5B-PadB5)" "B_D8" "B_D13" "B_{slash}MREQ" "B_A19"
    "B_{slash}CLK" "unconnected-(U6-3B-PadB3)" "B_{slash}HALT" "B_{slash}SXTRQ" "B_{slash}NMI" "B_D9" "B_{slash}IR1" "B_A23"
    "B_{slash}BUSAK" "B_DT{slash}R" "unconnected-(U6-23C-PadC23)" "B_A9" "B_A12" "B_A21" "B_{slash}DS1" "B_D10"
    "B_A11" "B_~{M1}" "B_A15" "B_{slash}IEI" "unconnected-(U7-O3a-Pad12)" "unconnected-(U7-I3a-Pad8)" "A2" "A1"
    "unconnected-(U7-O0b-Pad9)" "unconnected-(U7-I0b-Pad11)" "unconnected-(U8-Pad12)" "unconnected-(U8-Pad13)" "Net-(U11-O1)" "Net-(U8-Pad11)" "Net-(U11-O3)" "Net-(U11-O0)"
    "Net-(U11-O2)" "unconnected-(U9-Pad4)" "unconnected-(U9-Pad1)" "unconnected-(U9-Pad3)" "Net-(U14-I1a)" "Net-(U14-I0a)" "unconnected-(U9-Pad2)" "Net-(U14-I3a)"
    "~{PAROUT0}" "Net-(U10-OE)" "PARINT" "~{PAROUT2}" "unconnected-(U11-O7-Pad19)" "unconnected-(U11-O6-Pad16)" "~{PARIN0}" "~{PARIN1}"
    "unconnected-(U13-I1a-Pad4)" "unconnected-(U13-I2a-Pad6)" "unconnected-(U13-I0a-Pad2)" "~{PARIN2}" "unconnected-(U14-I1b-Pad13)" "unconnected-(U14-I2b-Pad15)" "unconnected-(U14-I3b-Pad17)" "unconnected-(U20-O0-Pad15)"
    "unconnected-(U20-O3-Pad12)" "unconnected-(U20-O2-Pad13)" "unconnected-(U20-O1-Pad14)" "unconnected-(U20-O7-Pad7)" "unconnected-(U21-O2-Pad13)" "unconnected-(U21-O1-Pad14)" "unconnected-(U21-O0-Pad15)" "unconnected-(U21-O5-Pad10)"
    "unconnected-(U21-O7-Pad7)" "unconnected-(U21-O3-Pad12)" "Net-(J1-Pin_14)" "Net-(J1-Pin_23)" "Net-(J1-Pin_24)" "A3" "A4"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "Power"
    "VCC" "GND"
    (clearance_class "default")
    (via_rule "default")
    (rule
      (width 1000.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)